{
  "brand": {
    "card_name": "HAQQ REPORT",
    "hashtag": "#HaqqReport",
    "footer": "Truth beats speed"
  },
  "mode": "auto",
  "mode_notes": "review = every draft goes to Telegram for approval (first 4 weeks). auto = Green and Amber post automatically, Red always needs approval.",
  "run": {
    "max_articles": 6,
    "max_telegram_drafts": 5,
    "max_per_source": 3,
    "off_mission_max": 2,
    "dedupe_days": 3,
    "max_posts_per_run": 2
  },
  "owner_feed": {
    "note": "Private Telegram messages to the owner (TELEGRAM_OWNER_ID). No public channel needed.",
    "posts": true,
    "errors": true,
    "daily_health_report": true,
    "log_file": "always",
    "log_file_note": "Send each run's log file to Telegram: always | on_error | never"
  },
  "enable": {
    "facebook": true,
    "instagram": true,
    "threads": true,
    "bluesky": false,
    "telegram_channel": false,
    "website": false
  },
  "limits": {
    "MAX_POSTS_PER_DAY": 10,
    "MAX_RED_PER_DAY": 4,
    "MIN_PALESTINE_PER_DAY": 2,
    "VERIFY_MIN_TIER": "C",
    "BREAKING_CHECK_MINUTES": 15,
    "GAP_HOURS": 3,
    "INGEST_MAX_AGE_HOURS": 48,
    "PLATFORM_FAILURES_BEFORE_PAUSE": 3
  },
  "scoring": {
    "weights": {
      "significance": 0.35,
      "impact": 0.3,
      "interest": 0.35
    },
    "gap_bonus": 0.8,
    "watch_topic_bonus": 0.5,
    "gap_major_wires_max": 2
  },
