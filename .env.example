# Haqq Report - environment variables (names only, no real values).
# Copy to .env for local runs. In production these live in GitHub Actions secrets.
# NEVER commit a filled-in .env file.

# --- Facebook Page (main Meta app ID/secret + never-expiring Page token) ---
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- Instagram (Instagram API with Instagram Login; its OWN app ID/secret, no Page link) ---
IG_APP_ID=
IG_APP_SECRET=
IG_USER_ID=
IG_TOKEN=

# --- Threads (its OWN app ID/secret) ---
TH_APP_ID=
TH_APP_SECRET=
TH_USER_ID=
TH_TOKEN=

# --- Token refresh write-back (fine-grained PAT, secrets:write on this repo only) ---
GH_PAT_SECRETS=
GITHUB_REPOSITORY=hayatpatel/haqq-report

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Bluesky (use an app password, not the account password) ---
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=

# --- AI providers (free tiers, used with failover) ---
GROQ_API_KEY=
GEMINI_API_KEY=
